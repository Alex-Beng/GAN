# ESP32-S3 only options. Kept separate from sdkconfig.defaults so the crate can
# still be type-checked against an ESP32-C3 sdkconfig (see watch/sdkconfig.c3.defaults).

# 8 MB PSRAM (N16R8 modules). The watch keeps a full-screen framebuffer and a
# queue of pending records in RAM; internal SRAM alone is not enough.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Larger main task stack is cheap with PSRAM-backed heap.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
